package CodeEditVcl;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$R *.res}
{$DESCRIPTION 'CodeEdit VCL component'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  designide;

contains
  CodeEdit.Completion in '..\Source\CodeEdit.Completion.pas',
  CodeEdit.Editor in '..\Source\CodeEdit.Editor.pas',
  CodeEdit.Highlighter in '..\Source\CodeEdit.Highlighter.pas',
  CodeEdit.Templates in '..\Source\CodeEdit.Templates.pas',
  CodeEdit.TemplateEditorDlg in '..\Source\CodeEdit.TemplateEditorDlg.pas',
  CodeEdit.Register in '..\Source\CodeEdit.Register.pas';

end.
