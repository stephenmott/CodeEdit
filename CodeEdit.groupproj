        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="CodeEditVcl">
        <MSBuild Projects="Packages\CodeEditVcl.dproj"/>
    </Target>
    <Target Name="CodeEditVcl:Clean">
        <MSBuild Projects="Packages\CodeEditVcl.dproj" Targets="Clean"/>
    </Target>
    <Target Name="CodeEditVcl:Make">
        <MSBuild Projects="Packages\CodeEditVcl.dproj" Targets="Make"/>
